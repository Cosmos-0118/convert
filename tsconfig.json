{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "qoi-fu": ["./src/handlers/vendor/qoi-fu/transpiled/QOI.js"],
      "qoa-fu": ["./src/handlers/vendor/qoa-fu/transpiled/QOA.js"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/handlers/vendor/qoi-fu/**/*",
    "src/handlers/vendor/qoa-fu/**/*",
    "src/handlers/vendor/sppd/**/*",
    "src/handlers/vendor/espeakng.js/**/*",
    "src/handlers/vendor/image-to-txt/src/app.ts",
    "src/handlers/vendor/image-to-txt/src/generate.ts",
    "src/handlers/vendor/terraria-wld-parser/**/*"
  ]
}
